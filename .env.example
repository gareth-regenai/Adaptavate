# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which workbook to drive. In production this is a Render Secret File.
WORKBOOK_PATH=model/Adaptavate-BBE-TEST-model.xlsx

# "formulas" (fast, ~16ms) or "libreoffice" (compatible, ~1s).
# Run tools/inspect_workbook.py against the real workbook before choosing.
CALC_BACKEND=formulas

# Partner tokens: receive the twelve public outputs only.
ACCESS_TOKENS=change-me-partner-1,change-me-partner-2

# Adaptavate tokens: additionally receive the internal-only figures.
INTERNAL_TOKENS=change-me-internal-1

ENVIRONMENT=development
SERVE_WEB=true
